# Copy this file to .env and fill in your local values.
# Never commit .env; it is ignored by Git.

DASHSCOPE_API_KEY=replace_with_your_dashscope_key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Use sample_data for a tiny synthetic demo, or point this to your own local
# private data directory with the same CSV schema.
BMS_RAG_DATA_DIR=sample_data
BMS_RAG_STORAGE_DIR=storage

